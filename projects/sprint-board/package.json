{
  "name": "sprint-board",
  "version": "1.0.0",
  "private": true,
  "description": "Scrum sprint board with story points and a burndown chart, built with React.",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --jsx=automatic --target=es2019 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/app.js",
    "dev": "esbuild src/main.jsx --bundle --jsx=automatic --sourcemap --define:process.env.NODE_ENV=\\\"development\\\" --outfile=dist/app.js --watch"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
